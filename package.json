{
  "name": "openfresno.org",
  "version": "2.0.0-beta.4",
  "private": true,
  "description": "The public website for Open Fresno.",
  "keywords": [
    "California",
    "Fresno",
    "civic",
    "meetup",
    "nextjs",
    "tailwind"
  ],
  "homepage": "https://openfresno.org",
  "bugs": {
    "url": "https://github.com/openfresno/openfresno.org/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Open Fresno",
    "email": "hello@openfresno.org",
    "url": "https://openfresno.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openfresno/openfresno.org.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "playwright test --project=chromium",
    "format": "vp check --fix",
    "format:prettier": "prettier . --write --log-level warn"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.4",
    "keen-slider": "^6.8.6",
    "moment": "^2.30.1",
    "next": "^16.3.4",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "swr": "^2.5.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.28",
    "prettier": "3.9.6",
    "prettier-plugin-css-order": "2.2.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4.3.3"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4"
  ],
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.19.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
